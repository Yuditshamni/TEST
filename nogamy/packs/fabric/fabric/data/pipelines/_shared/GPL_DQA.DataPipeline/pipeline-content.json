        "type": "String",
        "variableName": "WH_DWH_endpoint",
        "libraryName": "VL_DWH"
      },
      "WH_DWH_id": {
        "type": "String",
        "variableName": "WH_DWH_id",
        "libraryName": "VL_DWH"
      },
      "data_workspace_id": {
        "type": "String",
        "variableName": "data_workspace_id",
        "libraryName": "VL_DWH"
      }
    }
  }
